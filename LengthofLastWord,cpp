   int lengthOfLastWord(string s) {
        int length = 0;
    int i = s.size() - 1;

    // Skipping spaces
    while (i >= 0 && s[i] == ' ') {
        i--;
    }

    // Count  length of the last word
    while (i >= 0 && s[i] != ' ') {
        length++;
        i--;
    }

    return length;

         
    }
